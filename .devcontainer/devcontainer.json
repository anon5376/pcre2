{
  "name": "Default PCRE2 container",
  "build": { "dockerfile": "Dockerfile" },

  // Configure extension features
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "extensions": [
        "asciidoctor.asciidoctor-vscode",
        "bazelbuild.vscode-bazel",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "mesonbuild.mesonbuild",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpp-devtools",
        "ms-vscode.cpptools",
        "ms-vscode.hexeditor",
        "ms-vscode.makefile-tools",
        "redhat.vscode-yaml",
        "shopify.ruby-lsp",
        "ziglang.vscode-zig"
      ],
      "settings": {
        "[c]": {
          "editor.rulers": [
            { "column": 80, "color": "#666666" },
            { "column": 100, "color": "#ae0000" }
          ]
        },
        "[python][ruby]": {
          "editor.rulers": [
            { "column": 80, "color": "#666666" },
            { "column": 120, "color": "#ae0000" }
          ]
        },
        "[meson][cmake]": {
          "editor.rulers": [
            { "column": 80, "color": "#666666" },
            { "column": 120, "color": "#ae0000" }
          ]
        },
        "editor.rulers": [
          { "column": 78, "color": "#666666" },
          { "column": 80, "color": "#cccccc" }
        ],
        "files.associations": {
          "*.c.dist": "c",
          "*.c.ebcdic-*": "c",
          "*.c.non-standard": "c",
          "*.h.generic": "c",
          "*.h.in": "c"
        },
        "C_Cpp.clang_format_style": "file:${workspaceFolder}/maint/formatting/.clang-format",
        "C_Cpp.clang_format_path": "/usr/bin/clang-format-22",
        "cmake.generator": "Ninja",
        "zig.path": "/usr/local/bin/zig"
      }
    }
  }
}